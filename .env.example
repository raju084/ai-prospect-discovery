# Application Settings
APP_ENV=development
APP_PORT=4000
APP_HOST=0.0.0.0
DEBUG=True

# LLM Provider Configuration: "gemini", "openai", "anthropic", "groq", or "mock"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# API Keys (Provide at least one LLM key for live AI extraction, or leave empty for offline smart fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Search Provider Configuration: "ddg" (free, no key needed), "serpapi", "serper", or "mock"
SEARCH_PROVIDER=ddg
SERPAPI_API_KEY=
SERPER_API_KEY=

# Platform Discovery Settings
MAX_RESULTS_PER_PLATFORM=5
HTTP_TIMEOUT_SECONDS=10
CACHE_TTL_SECONDS=3600
ENABLE_MOCK_FALLBACK=True
